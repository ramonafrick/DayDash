<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:local="clr-namespace:DayDash.Maui"
       x:Class="DayDash.Maui.AppShell"
       Title="DayDash">

    <ShellContent Title="Calendar" ContentTemplate="{DataTemplate local:CalendarPage}" Route="CalendarPage" />
    <ShellContent Title="Create Exam" ContentTemplate="{DataTemplate local:ExamCreatePage}" Route="ExamCreatePage" />
    <ShellContent Title="Exam Details" ContentTemplate="{DataTemplate local:ExamDetailPage}" Route="ExamDetailPage" />
    <ShellContent Title="Subject Settings" ContentTemplate="{DataTemplate local:SubjectConfigPage}" Route="SubjectConfigPage" />
    <ShellContent Title="Reminder Settings" ContentTemplate="{DataTemplate local:ReminderSettingsPage}" Route="ReminderSettingsPage" />

</Shell>