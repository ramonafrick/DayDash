@inherits CultureAwareComponentBase
<div class="calendar-month-view">
    <div class="navigation">
        <button class="btn btn-secondary" @onclick="PreviousMonthAsync">@Loc["Previous"]</button>
        <span class="month-label">@MonthLabel</span>
        <button class="btn btn-secondary" @onclick="NextMonthAsync">@Loc["Next"]</button>
    </div>

    <div class="weekday-headers">
        @foreach (var header in WeekdayHeaders)
        {
            <div class="weekday-header">@header</div>
        }
    </div>

    <div class="month-grid">
        @foreach (var week in _weeks)
        {
            <div class="week-row">
                @foreach (var day in week.Days)
                {
                    <button type="button"
                            class="day-cell @(day.IsCurrentMonth ? "" : "other-month") @(day.IsToday ? "today" : "")"
                            @onclick="() => SelectDayAsync(day.Date)">
                        <span class="day-number">@day.Date.Day</span>
                        <div class="event-dots">
                            @foreach (var color in day.DotColors)
                            {
                                <span class="event-dot" style="background-color:@color"></span>
                            }
                        </div>
                    </button>
                }
            </div>
        }
    </div>
</div>
