<div class="event-detail">
    <h2>@Event.Title</h2>
    <p>@Loc["Date"]: @Event.Date.ToString("dd MMM yyyy")</p>
    @if (!Event.IsAllDay)
    {
        <p>@Loc["Time"]: @Event.TimeFrom?.ToString("HH:mm") - @Event.TimeTo?.ToString("HH:mm")</p>
    }
    <p>@Loc["Notes"]: @Event.Notes</p>

    <button @onclick="(() => OnEdit.InvokeAsync(Event))">@Loc["Edit"]</button>
    <button @onclick="(() => OnDelete.InvokeAsync(Event))">@Loc["Delete"]</button>
</div>