@inherits CultureAwareComponentBase
@inject IStringLocalizer<CameraResources> Loc

<div>
    <table>
        @foreach (var goal in Goals)
        {
            <tr>
                <td><input type="checkbox" @bind="goal.IsChecked" /></td>
                <td><input type="text" @bind="goal.Text" /></td>
                <td>
                    <button @onclick="() => MoveUp(goal)">@Loc["MoveUp"]</button>
                    <button @onclick="() => MoveDown(goal)">@Loc["MoveDown"]</button>
                    <button @onclick="() => DeleteGoal(goal)">@Loc["DeleteRow"]</button>
                </td>
            </tr>
        }
    </table>
    <button @onclick="AddGoal">@Loc["AddRow"]</button>
    <button @onclick="SaveGoals">@Loc["SaveGoals"]</button>
</div>