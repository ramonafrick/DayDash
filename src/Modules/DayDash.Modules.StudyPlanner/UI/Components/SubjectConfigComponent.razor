@inherits CultureAwareComponentBase

<div class="subject-config container">
    <h1 class="page-title">@Loc["SubjectConfig"]</h1>

    @if (_toast is not null)
    {
        <div class="alert alert-info" role="status">@_toast</div>
    }

    <div class="card">
        <table class="subject-table">
            <thead>
                <tr>
                    <th>@Loc["Subject"]</th>
                    <th>@Loc["MinutesPerGoal"]</th>
                    <th>@Loc["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var subject in _subjects)
                {
                    <tr>
                        <td>
                            <input type="text" class="form-input" value="@subject.Name"
                                   @onchange="e => subject.Name = e.Value?.ToString() ?? subject.Name" />
                        </td>
                        <td>
                            <input type="number" min="0" class="form-input" value="@subject.MinutesPerGoal"
                                   @onchange="e => subject.MinutesPerGoal = int.TryParse(e.Value?.ToString(), out var v) ? v : subject.MinutesPerGoal" />
                        </td>
                        <td class="row-actions">
                            <button class="btn btn-secondary" @onclick="() => SaveAsync(subject)">@Loc["Save"]</button>
                            <button class="btn btn-error" @onclick="() => DeleteAsync(subject)">@Loc["Delete"]</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <button class="btn btn-primary" @onclick="AddAsync">@Loc["AddSubject"]</button>
    </div>
</div>
