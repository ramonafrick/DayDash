@inherits CultureAwareComponentBase

<div class="today-study-plan card">
    <h3>@Loc["TodayStudyPlan"]</h3>

    @if (_plan.Count == 0)
    {
        <p>@Loc["NoStudyToday"]</p>
    }
    else
    {
        <ul>
            @foreach (var exam in _plan)
            {
                <li>@Loc["Study"]: @exam.Subject – @exam.DailyMinutes @Loc["Minutes"]</li>
            }
        </ul>
        <p class="total">@Loc["TotalMinutesToday"]: @_totalMinutes @Loc["Minutes"]</p>
    }
</div>
