@inherits CultureAwareComponentBase
@inject IStringLocalizer<NavigationResources> Localizer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="calendar" @onclick="HandleNavClick">
            <img src="_content/DayDash.Modules.Settings/img/daydash-logo.svg" alt="@Localizer["BrandName"]" class="navbar-brand-icon" />
            @Localizer["BrandName"]
        </a>
    </div>
</div>

<div class="nav-scrollable">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="calendar" @onclick="HandleNavClick">
                <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span> @Localizer["Calendar"]
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="study" @onclick="HandleNavClick">
                <span class="material-symbols-outlined" aria-hidden="true">menu_book</span> @Localizer["StudyPlan"]
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="camera" @onclick="HandleNavClick">
                <span class="material-symbols-outlined" aria-hidden="true">photo_camera</span> @Localizer["Camera"]
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings" @onclick="HandleNavClick">
                <span class="material-symbols-outlined" aria-hidden="true">settings</span> @Localizer["Settings"]
            </NavLink>
        </div>
    </nav>
</div>

@code {
    [Parameter] public EventCallback OnNavLinkClick { get; set; }

    private async Task HandleNavClick()
    {
        if (OnNavLinkClick.HasDelegate)
        {
            await OnNavLinkClick.InvokeAsync();
        }
    }
}
